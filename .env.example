NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_api_key_here
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Used for canonical links, sitemap.xml, robots.txt, and Open Graph/Twitter
# image URLs.
NEXT_PUBLIC_SITE_URL=https://ridegems.eu
# Server-only, never NEXT_PUBLIC_. Used by local migration/seed scripts and by
# admin-only server actions (route delete, editing routes you don't own). Get
# from Supabase dashboard -> Project Settings -> API -> service_role key. Add
# this line yourself directly in .env.local -- do not paste this key into chat.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Server-only, never NEXT_PUBLIC_. The account email allowed to delete any
# route and edit routes you don't own. Add this line yourself directly in
# .env.local (and in Vercel's project env vars) -- do not paste it into chat.
ADMIN_EMAIL=your_account_email_here
