NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_api_key_here
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only, never NEXT_PUBLIC_. Used only by local migration/seed scripts. Get from
# Supabase dashboard -> Project Settings -> API -> service_role key. Add this line
# yourself directly in .env.local -- do not paste this key into chat.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
